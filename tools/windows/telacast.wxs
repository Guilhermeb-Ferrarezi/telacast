<?xml version="1.0" encoding="utf-8"?>
<!-- Instalador do Telacast para Windows (feito com `wixl`, do msitools; ver build-msi.sh).
     Instalação POR USUÁRIO: não pede administrador e instala em %LOCALAPPDATA%\Programs\Telacast, pasta
     onde o próprio app consegue se atualizar. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Telacast" Language="1046" Codepage="1252" Version="@VERSION@"
           Manufacturer="Guilherme Barbosa Ferrarezi" UpgradeCode="6B0F1B7A-3D2C-4C58-9A3E-1F7A2D9C4E10">
    <Package Id="*" Description="Telacast" InstallerVersion="500" Compressed="yes" InstallScope="perUser"
             Manufacturer="Guilherme Barbosa Ferrarezi" Comments="Clone do Discord em Rust"/>
    <MajorUpgrade DowngradeErrorMessage="Já existe uma versão mais nova do Telacast instalada."/>
    <Media Id="1" Cabinet="telacast.cab" EmbedCab="yes"/>
    <Icon Id="telacast.ico" SourceFile="telacast.ico"/>
    <Property Id="ARPPRODUCTICON" Value="telacast.ico"/>
    <Property Id="ARPCOMMENTS" Value="Clone do Discord em Rust: chat, voz e transmissão de tela"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLDIR" Name="Telacast">
            <Component Id="TelacastExe" Guid="*" Win64="yes">
              <File Id="TelacastExeFile" Name="Telacast.exe" Source="Telacast.exe" KeyPath="yes"/>
              <RegistryValue Root="HKCU" Key="Software\Telacast" Name="InstallDir" Type="string" Value="[INSTALLDIR]"/>
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenuShortcut" Guid="*" Win64="yes">
          <Shortcut Id="StartMenuTelacast" Name="Telacast" Description="Telacast" Target="[INSTALLDIR]Telacast.exe"
                    WorkingDirectory="INSTALLDIR" Icon="telacast.ico"/>
          <RegistryValue Root="HKCU" Key="Software\Telacast" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes"/>
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Main" Title="Telacast" Level="1">
      <ComponentRef Id="TelacastExe"/>
      <ComponentRef Id="StartMenuShortcut"/>
    </Feature>
  </Product>
</Wix>
